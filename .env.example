# NEXUS — Environment Configuration Template
# Copy this file to .env and configure real credentials for desired services.

# ==============================================================================
# Server Configuration
# Defaults: Local development runs on 4000. In Cloud Run, PORT is injected (e.g. 8080).
# ==============================================================================
PORT=4000
HOST=0.0.0.0
DEBUG=false
ENVIRONMENT=production
REQUEST_TIMEOUT_SECONDS=15.0

# ==============================================================================
# LLM Providers (for AI-Powered Website Link Analysis: POST /link-analysis)
# ==============================================================================
# Default provider to use: "gemini", "openai", or "groq"
DEFAULT_LLM_PROVIDER=gemini
DEFAULT_GEMINI_MODEL=gemini-2.5-flash

# Google Gemini API Key
# Put your Gemini API Key here (or export GEMINI_API_KEY=... in your environment):
GEMINI_API_KEY=

# Optional alternative providers
OPENAI_API_KEY=
DEFAULT_OPENAI_MODEL=gpt-4o-mini

GROQ_API_KEY=
DEFAULT_GROQ_MODEL=llama-3.3-70b-versatile

# ==============================================================================
# Social Publishing Platforms (for Multi-Platform Publishing: POST /posting)
# ==============================================================================
# Bluesky (AT Protocol)
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
BLUESKY_PDS_URL=https://bsky.social

# Mastodon (REST API)
MASTODON_INSTANCE_URL=
MASTODON_ACCESS_TOKEN=

# Telegram (Bot API)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord (Execute Webhook API)
DISCORD_WEBHOOK_URL=

# Reddit (OAuth2 API)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_USER_AGENT=nexus-publishing-engine/1.0
REDDIT_SUBREDDIT=
