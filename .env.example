# NEXUS — Environment Configuration Template
# Copy this file to .env and configure real credentials for desired platforms.

# ==============================================================================
# Server Configuration
# ==============================================================================
PORT=4000
HOST=0.0.0.0
DEBUG=false
ENVIRONMENT=production
REQUEST_TIMEOUT_SECONDS=10.0
MAX_RETRIES=2

# ==============================================================================
# Platform 1: Bluesky (AT Protocol)
# Official Docs: https://docs.bsky.app/docs/category/http-reference
# Requires: Bluesky handle (e.g. user.bsky.social) and App Password
# ==============================================================================
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
BLUESKY_PDS_URL=https://bsky.social

# ==============================================================================
# Platform 2: Mastodon (REST API)
# Official Docs: https://docs.joinmastodon.org/methods/statuses/
# Requires: Instance URL (e.g. https://mastodon.social) and OAuth Access Token
# ==============================================================================
MASTODON_INSTANCE_URL=
MASTODON_ACCESS_TOKEN=

# ==============================================================================
# Platform 3: Telegram (Bot API)
# Official Docs: https://core.telegram.org/bots/api#sendmessage
# Requires: Bot Token from @BotFather and Target Chat/Channel ID (or @channelusername)
# ==============================================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ==============================================================================
# Platform 4: Discord (Execute Webhook API)
# Official Docs: https://discord.com/developers/docs/resources/webhook#execute-webhook
# Requires: Webhook URL created in channel settings
# ==============================================================================
DISCORD_WEBHOOK_URL=

# ==============================================================================
# Platform 5: Reddit (OAuth2 API)
# Official Docs: https://www.reddit.com/dev/api#POST_api_submit
# Requires: Script app credentials (client_id, client_secret), username, password, target subreddit
# ==============================================================================
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_USER_AGENT=nexus-publishing-engine/1.0
REDDIT_SUBREDDIT=
